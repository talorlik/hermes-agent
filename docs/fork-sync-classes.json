{
  "version": 1,
  "generated_unspecified": {
    "action": "take-upstream",
    "paths": [
      "uv.lock",
      "pm/uv.lock",
      "pm/lock.json",
      "flake.lock",
      "nix/pythonLock.nix",
      "nix/npm-pinned.nix"
    ]
  },
  "build_output": {
    "action": "regenerate-or-stop",
